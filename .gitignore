# Pinned Metaplex Core program binary for deterministic CI/localnet. The
# exact artifact is committed and hash-verified on every run. Temporary
# download/intermediate files are still ignored.
/vendor/mpl-core/*.tmp
/vendor/mpl-core/*.so
!/vendor/mpl-core/mpl_core_program.so
/vendor/mpl-core/*.sha256
!/vendor/mpl-core/mpl_core_program.so.sha256

