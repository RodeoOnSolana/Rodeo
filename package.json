{
  "name": "rodeo",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm build && pnpm -r --if-present test",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "verify": "pnpm install --frozen-lockfile && pnpm build && pnpm typecheck && pnpm test && cargo fmt --all -- --check && cargo check --workspace --all-targets --locked",
    "program-keys:localnet": "node scripts/prepare-localnet-program-keys.mjs",
    "anchor:build": "pnpm program-keys:localnet && anchor build",
    "anchor:deploy:localnet": "pnpm anchor:build && anchor deploy",
    "sdk:generate": "pnpm --filter @rodeo/sdk generate",
    "sdk:validate": "node scripts/verify-generated-artifacts.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "overrides": {
      "rpc-websockets>uuid": "9.0.1"
    }
  }
}
